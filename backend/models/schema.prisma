generator client {
  provider      = "prisma-client-js"
  // native: desarrollo; rhel-openssl-3.0.x: las funciones de Vercel (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  icon        String?
  createdAt   DateTime @default(now())
  users       User[]
  pages       Page[]  @relation("DepartmentPages")
  templates   Template[]
  wallPageId  String?  @unique
  wallPage    Page?    @relation("DepartmentWall", fields: [wallPageId], references: [id], onDelete: SetNull)
  featured    DepartmentFeaturedPage[]
}

model User {
  id            String   @id @default(cuid())
  name          String
  /// Nombre normalizado sin tildes para buscar todo el directorio en la base de datos.
  searchName    String   @default("")
  email         String   @unique
  passwordHash  String
  role          String   @default("USER")
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  active        Boolean  @default(true)
  sessionVersion Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pages          Page[] @relation("PageOwner")
  shares         PageShare[]
  histories      PageHistory[]
  visits         PageVisit[]
  templates      Template[]
  uploads        FileAsset[]
  syncOperations SyncOperation[]
  shareLinks     PageShareLink[] @relation("PageShareLinkCreator")
  templateShares TemplateShare[]
  templateShareLinks TemplateShareLink[] @relation("TemplateShareLinkCreator")
}

model Page {
  id             String   @id @default(cuid())
  title          String
  icon           String?
  contentJson    String   @default("[]")
  backgroundJson String?
  /// Título y texto del contenido en minúsculas y sin tildes, para buscar (lo calcula services/search-text.ts).
  searchText     String   @default("")
  visibility     String   @default("PRIVATE")
  version        Int      @default(1)
  isWall         Boolean  @default(false)
  isCompanyWall  Boolean  @default(false)
  ownerId        String
  owner          User     @relation("PageOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  departmentId   String
  department     Department @relation("DepartmentPages", fields: [departmentId], references: [id], onDelete: Restrict)
  parentId        String?
  parent          Page?    @relation("SubPages", fields: [parentId], references: [id], onDelete: SetNull)
  children        Page[]   @relation("SubPages")
  departmentWall Department? @relation("DepartmentWall")
  companyWall    CompanySettings? @relation("CompanyWall")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  shares          PageShare[]
  shareLinks      PageShareLink[]
  history         PageHistory[]
  visits          PageVisit[]
  files           FileAsset[]
  tags            Tag[]
  featuredIn      DepartmentFeaturedPage[]
  companyFeatured CompanyFeaturedPage?
  collabState     PageCollabState?
  collabDoc       CollabDoc?
  collabUpdates   CollabUpdate[]
  collabPresence  CollabPresence[]

  @@index([departmentId, visibility, deletedAt])
  @@index([ownerId, deletedAt])
  @@index([parentId])
}

model PageShare {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  String
  createdAt   DateTime @default(now())
  @@unique([pageId, userId])
}

model PageShareLink {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  permission  String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?    @relation("PageShareLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  @@index([pageId, revokedAt])
}

model PageHistory {
  id           String   @id @default(cuid())
  pageId       String
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  changedById  String
  changedBy    User     @relation(fields: [changedById], references: [id], onDelete: Restrict)
  version      Int
  snapshotJson String
  createdAt    DateTime @default(now())
  @@unique([pageId, version])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  pages Page[]
}

model PageVisit {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitedAt DateTime @default(now())
  @@index([pageId, visitedAt])
  @@index([pageId, userId, visitedAt])
}

model Template {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  icon          String?
  contentJson   String   @default("[]")
  backgroundJson String?
  scope         String   @default("PRIVATE")
  isDefault     Boolean  @default(false)
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shares        TemplateShare[]
  shareLinks    TemplateShareLink[]
  files         FileAsset[]
  @@index([scope, departmentId, isDefault])
}

model TemplateShare {
  id          String   @id @default(cuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  String
  createdAt   DateTime @default(now())
  @@unique([templateId, userId])
  @@index([userId])
}

model TemplateShareLink {
  id          String   @id @default(cuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  permission  String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?    @relation("TemplateShareLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  @@index([templateId, revokedAt])
}

model FileAsset {
  id          String   @id @default(cuid())
  storageName String   @unique
  originalName String
  mimeType    String
  sizeBytes   Int
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pageId      String?
  page        Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  /// Contenido en la base (FILE_STORAGE=database, producción sin disco permanente); en disco no tiene fila.
  blob        FileBlob?
  @@index([ownerId, createdAt])
  @@index([templateId])
}

/// Bytes de un archivo subido cuando se guardan en la base. Tabla aparte para no cargarlos al listar archivos.
model FileBlob {
  storageName String    @id
  data        Bytes
  asset       FileAsset @relation(fields: [storageName], references: [storageName], onDelete: Cascade)
}

model SyncOperation {
  id           String   @id @default(cuid())
  operationId  String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId       String
  resultJson   String
  createdAt    DateTime @default(now())
  @@unique([userId, operationId])
}

model CompanySettings {
  id             String @id @default("main")
  wallPageId     String? @unique
  wallPage       Page? @relation("CompanyWall", fields: [wallPageId], references: [id], onDelete: SetNull)
}

model DepartmentFeaturedPage {
  id           String @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  pageId       String
  page         Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sortOrder    Int @default(0)
  @@unique([departmentId, pageId])
  @@index([departmentId, sortOrder])
}

/// Páginas destacadas del muro de la empresa (solo páginas publicadas a la empresa; máximo 12).
model CompanyFeaturedPage {
  id        String @id @default(cuid())
  pageId    String @unique
  page      Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)
  @@index([sortOrder])
}

/// Estado Yjs de la edición en vivo (realtime/collab.ts). Solo se usa si `pageVersion` coincide con la
/// versión actual de la página: si alguien la cambió por REST (restaurar, sincronizar), se descarta.
model PageCollabState {
  pageId      String   @id
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  state       Bytes
  pageVersion Int
  updatedAt   DateTime @updatedAt
}

/// Edición en vivo por HTTP (producción en Vercel, sin WebSockets). Documento Yjs compactado de una página.
/// `epoch` cambia cuando el contenido se reemplaza por otra vía (restaurar una versión): los editores abiertos
/// con otro epoch reciben 409 y vuelven a cargar la página.
model CollabDoc {
  pageId       String   @id
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  epoch        String
  snapshot     Bytes
  /// Las actualizaciones con id <= lastUpdateId ya están dentro de snapshot.
  lastUpdateId Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Cambios de Yjs que llegan de los editores (solo se agregan; se compactan en CollabDoc.snapshot).
model CollabUpdate {
  id        Int      @id @default(autoincrement())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  data      Bytes
  userId    String
  createdAt DateTime @default(now())

  @@index([pageId, id])
}

/// Presencia ("también editando") por cliente de Yjs. `state` en JSON; null = salió de la página.
model CollabPresence {
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// clientID de Yjs (entero sin signo de 32 bits; se guarda como texto).
  clientId  String
  userId    String
  clock     Int
  state     String?
  updatedAt DateTime @updatedAt

  @@id([pageId, clientId])
  @@index([pageId, updatedAt])
}
