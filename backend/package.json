{
  "name": "wiki-en-equipo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API para Wiki en equipo",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch api/server.ts",
    "start": "node dist/api/server.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate --schema models/schema.prisma",
    "db:migrate": "prisma migrate dev --schema models/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema models/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "zod": "^4.1.11",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/ws": "^8.18.1",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
