# Base local (desarrollo y pruebas): archivo SQLite, sin internet.
DATABASE_URL="file:./dev.db"
# Producción en Turso (SQLite en la nube): con estas dos variables, Prisma usa el adaptador de libSQL y, al
# arrancar, el servidor aplica las migraciones que falten. Déjalas vacías en local. Nunca las subas al repositorio.
# TURSO_DATABASE_URL="libsql://<base>-<cuenta>.turso.io"
# TURSO_AUTH_TOKEN=""
JWT_SECRET="replace-with-a-long-random-secret"
BOOTSTRAP_SECRET="replace-before-first-admin-setup"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
# Dónde se guardan los archivos subidos: "disk" (UPLOAD_DIR) o "database" (dentro de la base; las funciones de
# Vercel no conservan el disco). Sin definir: "database" con Turso y "disk" sin él.
# FILE_STORAGE="disk"
UPLOAD_DIR="./uploads"
# En producción 4194304 (4 MB): las subidas pasan por Vercel, que no acepta más de 4,5 MB.
MAX_UPLOAD_BYTES=10485760
MAX_UPLOADS_PER_USER=1000
# Proxies que pueden informar la IP real (X-Forwarded-For): "loopback" si Next corre en la misma máquina,
# un número de saltos o una lista de IP/subredes. Nunca "true".
TRUST_PROXY="loopback"
# Días que una página pasa en la papelera antes de borrarse para siempre (0 = nunca).
TRASH_RETENTION_DAYS=30
# Edición en vivo (ws://<backend>/collab/pagina-<id>). Otros orígenes permitidos además de FRONTEND_ORIGIN (separados por comas).
# Orígenes que pueden usar la edición en vivo y la API desde el navegador (CORS), además de FRONTEND_ORIGIN.
# COLLAB_ALLOWED_ORIGINS="https://wiki.grupocomidas.example"
# COLLAB_SAVE_DELAY_MS=2000
# COLLAB_MAX_CLIENTS_PER_PAGE=50
# COLLAB_MAX_CONNECTIONS_PER_USER=20
# --- Producción en Vercel ---
# Secreto compartido con el frontend: el servidor de Next manda la IP real del inicio de sesión en
# X-Wiki-Client-Ip con este secreto (Vercel reescribe X-Forwarded-For). El mismo valor en los dos proyectos.
# PROXY_SECRET=""
# Vercel Cron limpia la papelera una vez al día llamando a /api/cron/papelera con este secreto.
# CRON_SECRET=""
